# Copy this file to .env and paste your real key. .env is gitignored.
#
# Get a key in about two minutes:
#   1. Go to https://web3forms.com
#   2. Enter the email address that should receive the leads
#   3. Check that inbox and copy the access key they send you
#
# The PUBLIC_ prefix is what exposes the value to the built page. Without it
# the form ships with no key and submissions will fail.
#
# This key is not a secret in the usual sense. It only lets a submission be
# delivered to the inbox that created it, and it is visible in the page
# source of any site that uses Web3Forms. It is kept out of git so the demo
# repo does not route strangers' submissions into a real inbox.
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Where the site tells visitors to email if the form fails. Shown on the page.
PUBLIC_CONTACT_EMAIL=niftystudiodesigns@gmail.com
