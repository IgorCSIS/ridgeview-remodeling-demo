---
/**
 * Thank-you page.
 *
 * A real route rather than an in-place swap, for three reasons: it is the
 * only conversion event on the site and needs somewhere to fire, the no-JS
 * form post has to land somewhere, and there is real work for this page to
 * do while the homeowner waits.
 *
 * It is noindex and excluded from the sitemap. It is a post-conversion
 * destination, not a landing page.
 *
 * The checklist is the point. The homeowner is collecting two or three
 * quotes whether or not we acknowledge it, so the page says so plainly and
 * hands them the comparison framework. That keeps them here while they wait
 * and frames the comparison on the terms a careful builder wins on.
 */
import Layout from "@layouts/Layout.astro";
import { thanks, business } from "../data/content";
import Icon from "@components/Icon.astro";
---

<Layout title={`Thanks | ${business.name}`} description="We got your request." noindex={true}>
  <section class="band-dark">
    <div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow is-visible">Request received</p>
        <h1 class="t-display mt-6 text-sand-50">{thanks.title}</h1>
        <p class="t-lead mt-6 !text-sand-400">{thanks.body}</p>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-content px-5 sm:px-8">
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="card p-7 lg:col-span-4">
          <h2 class="t-h3">{thanks.saveLabel}</h2>
          <p class="mt-3 text-small text-ink-600">{thanks.saveBody}</p>
          <a href={business.phoneHref} class="btn btn-primary mt-5 w-full">
            <Icon name="phone" class="h-4 w-4" />
            {business.phone}
          </a>
        </div>

        <div class="card p-7 lg:col-span-4">
          <h2 class="t-h3">{thanks.urgentLabel}</h2>
          <p class="mt-3 text-small text-ink-600">{thanks.urgentBody}</p>
        </div>

        <div class="card p-7 lg:col-span-4">
          <h2 class="t-h3">{thanks.prepTitle}</h2>
          <ul class="mt-4 space-y-2.5">
            {thanks.prep.map((item) => (
              <li class="flex items-start gap-2.5 text-small text-ink-600">
                <Icon name="check" class="mt-1 h-3.5 w-3.5 shrink-0 text-ember-600" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-12 rounded-panel border border-line bg-sand-200 p-7 sm:p-10">
        <h2 class="t-h2">{thanks.checklistTitle}</h2>
        <p class="t-lead mt-4">{thanks.checklistIntro}</p>
        <ol class="mt-8 grid gap-x-10 gap-y-4 sm:grid-cols-2">
          {thanks.checklist.map((q, i) => (
            <li class="flex items-start gap-3 text-small text-ink-600">
              <span class="font-display text-small font-semibold text-ember-700">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span>{q}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="mt-10">
        <a href={import.meta.env.BASE_URL} class="btn btn-secondary">Back to the site</a>
      </p>
    </div>
  </section>
</Layout>
