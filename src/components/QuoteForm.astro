---
/**
 * The quote form. The only conversion action on the site.
 *
 * It posts to Web3Forms, which emails the owner and has a free tier around
 * 250 submissions a month. It is a real HTML form with a real action, so it
 * works with scripting disabled: Web3Forms redirects to the _next URL and
 * the visitor lands on the thank-you page either way. src/scripts/form.ts
 * upgrades it to a fetch submit with field-level validation.
 *
 * Field order is the highest-leverage decision here. It opens with taps
 * about the homeowner's own project, which they are glad to answer, and puts
 * contact details last with the phone number dead last. By the time they
 * reach the field they like least, they have already answered five things.
 *
 * There is no file upload. Photos would genuinely improve a lead, but every
 * free form backend charges for attachments and this demo runs at zero cost.
 */
import { quoteForm, business } from "../data/content";
import Icon from "@components/Icon.astro";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const isConfigured = accessKey.length > 0;

// Two forms of the same destination, on purpose.
//
// Web3Forms requires an absolute URL for its no-JS redirect, so that is what
// goes in the hidden field. The scripted path navigates using the relative
// path instead, because an absolute production URL would send anyone
// previewing the site on another origin off to the live domain mid-submit.
const thanksPath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/thanks/`;
const thanksUrl = new URL(thanksPath, Astro.site ?? "https://igorcsis.github.io").href;

const f = quoteForm.fields;
---

<section id="quote" class="py-section lg:py-section-lg">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <div data-reveal>
          <p class="eyebrow">{quoteForm.eyebrow}</p>
          <h2 class="t-h2 mt-5">{quoteForm.title}</h2>
          <p class="t-lead mt-5">{quoteForm.intro}</p>
        </div>

        {!isConfigured && (
          <p class="mt-6 rounded-card border border-danger-line bg-danger-bg px-5 py-4 text-small text-danger">
            <strong>Not wired up yet.</strong> This build has no Web3Forms access key, so the form below cannot send.
            Add <code>PUBLIC_WEB3FORMS_ACCESS_KEY</code> and rebuild. The README has the two-minute version.
          </p>
        )}

        <form
          id="quote-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          novalidate
          class="mt-9 space-y-6"
          data-thanks={thanksPath}
          data-reveal
          style="transition-delay:80ms"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value={`New ${business.shortName} lead`} />
          <input type="hidden" name="from_name" value={business.name} />
          <!-- No-JS path: Web3Forms redirects here after a successful post. -->
          <input type="hidden" name="redirect" value={thanksUrl} />
          <!-- Honeypot. Bots fill every field they can see. -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="field-label" for="q-project">{f.projectType.label} <span class="text-ember-600">*</span></label>
              <select id="q-project" name="Project type" class="field" required>
                {f.projectType.options.map((o) => <option value={o}>{o}</option>)}
              </select>
              <span class="field-help">{f.projectType.help}</span>
            </div>
            <div>
              <label class="field-label" for="q-timeline">{f.timeline.label} <span class="text-ember-600">*</span></label>
              <select id="q-timeline" name="Timeline" class="field" required>
                {f.timeline.options.map((o) => <option value={o}>{o}</option>)}
              </select>
              <span class="field-help">{f.timeline.help}</span>
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="field-label" for="q-budget">{f.budget.label}</label>
              <select id="q-budget" name="Budget" class="field">
                {f.budget.options.map((o) => <option value={o}>{o}</option>)}
              </select>
              <span class="field-help">{f.budget.help}</span>
            </div>
            <div>
              <label class="field-label" for="q-city">{f.city.label} <span class="text-ember-600">*</span></label>
              <input id="q-city" name="City or ZIP" class="field" type="text" required autocomplete="address-level2" placeholder="El Cajon or 92019" aria-describedby="q-city-error" />
              <p id="q-city-error" class="mt-1.5 hidden text-small text-danger" data-error-for="City or ZIP"></p>
              <span class="field-help">{f.city.help}</span>
            </div>
          </div>

          <div>
            <label class="field-label" for="q-details">{f.details.label} <span class="text-ember-600">*</span></label>
            <textarea id="q-details" name="Project details" class="field resize-y" rows="5" required placeholder="Rooms, rough size, and anything that worries you." aria-describedby="q-details-error"></textarea>
            <p id="q-details-error" class="mt-1.5 hidden text-small text-danger" data-error-for="Project details"></p>
            <span class="field-help">{f.details.help}</span>
          </div>

          <hr class="rule" />

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="field-label" for="q-name">{f.name.label} <span class="text-ember-600">*</span></label>
              <input id="q-name" name="Name" class="field" type="text" required autocomplete="name" placeholder="First and last" aria-describedby="q-name-error" />
              <p id="q-name-error" class="mt-1.5 hidden text-small text-danger" data-error-for="Name"></p>
            </div>
            <div>
              <label class="field-label" for="q-email">{f.email.label} <span class="text-ember-600">*</span></label>
              <input id="q-email" name="Email" class="field" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" aria-describedby="q-email-error" />
              <p id="q-email-error" class="mt-1.5 hidden text-small text-danger" data-error-for="Email"></p>
            </div>
          </div>

          <div>
            <label class="field-label" for="q-phone">{f.phone.label} <span class="text-ember-600">*</span></label>
            <!-- type/inputmode/autocomplete together raise the phone keypad
                 rather than the full keyboard, which is most of the friction
                 on this field. -->
            <input id="q-phone" name="Phone" class="field" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(619) 555-0142" aria-describedby="q-phone-error" />
            <p id="q-phone-error" class="mt-1.5 hidden text-small text-danger" data-error-for="Phone"></p>
            <span class="field-help">{f.phone.help}</span>
            <label class="mt-3 flex items-center gap-2.5 text-small text-ink-600">
              <input type="checkbox" name="Prefers text" value="Yes" class="h-5 w-5 rounded border-line-strong text-ember-600" />
              {f.phone.textOptIn}
            </label>
          </div>

          <div>
            <label class="field-label" for="q-source">{f.source.label}</label>
            <input id="q-source" name="How they heard" class="field" type="text" placeholder="Google, a neighbor, drove past a job" />
          </div>

          <div class="rounded-card border border-line bg-sand-200 p-6">
            <h3 class="text-label font-semibold uppercase text-ink-500">{quoteForm.nextTitle}</h3>
            <ol class="mt-4 space-y-2.5">
              {quoteForm.nextSteps.map((step, i) => (
                <li class="flex items-start gap-3 text-small text-ink-600">
                  <span class="font-display text-small font-semibold text-ember-700">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
            <p class="mt-4 border-t border-line pt-4 text-small text-ink-600">{quoteForm.nextFootnote}</p>
          </div>

          <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>
              <span data-submit-label>{quoteForm.submitLabel}</span>
              <Icon name="arrow" class="h-4 w-4" />
            </button>
            <p class="text-small text-ink-500">Takes about two minutes.</p>
          </div>

          <p class="text-small text-ink-500">{quoteForm.privacy}</p>

          <p id="form-status" role="status" aria-live="polite" class="hidden rounded-card border px-5 py-4 text-small"></p>
        </form>
      </div>

      <aside class="lg:col-span-5">
        <div class="card sticky top-28 p-7" data-reveal style="transition-delay:140ms">
          <h3 class="t-h3">Who you will be talking to</h3>
          <p class="mt-3 text-small text-ink-600">
            {business.owner} runs the crews and reads every request that comes through this form. One point of
            contact from the first call to the last walkthrough.
          </p>
          <hr class="rule my-6" />
          <h3 class="t-h3">Rather just call?</h3>
          <a href={business.phoneHref} class="mt-3 inline-flex items-center gap-2 text-lead font-semibold text-ember-700 hover:text-ember-600">
            <Icon name="phone" class="h-5 w-5" />
            {business.phone}
          </a>
          <p class="mt-3 text-small text-ink-500">Monday to Friday, 7:30 to 4:00.</p>
        </div>
      </aside>
    </div>
  </div>
</section>
