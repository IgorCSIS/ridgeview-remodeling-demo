---
/**
 * FAQ, deliberately below the form. It catches the visitor who scrolled past
 * with one unresolved question and sends them back up.
 *
 * Built on native <details>, so every question opens with scripting off and
 * screen readers get the disclosure semantics without any ARIA of our own.
 */
import { faq, hero } from "../data/content";
import Icon from "@components/Icon.astro";
---

<section id="faq" class="bg-sand-200 py-section lg:py-section-lg">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <div data-reveal>
          <p class="eyebrow">{faq.eyebrow}</p>
          <h2 class="t-h2 mt-5">{faq.title}</h2>
          <p class="mt-5 text-small text-ink-600">
            Anything not answered here, put it in the form and we will answer it straight.
          </p>
          <a href={hero.primaryCta.href} class="btn btn-primary mt-7 w-full sm:w-auto">{hero.primaryCta.label}</a>
        </div>
      </div>

      <div class="lg:col-span-8">
        <ul class="border-t border-line">
          {faq.items.map((item, i) => (
            <li class="border-b border-line" data-reveal style={`transition-delay:${i * 40}ms`}>
              <details class="faq-item group">
                <summary class="flex items-start justify-between gap-6 py-5 text-left">
                  <span class="t-h3 transition-colors group-hover:text-ember-700">{item.q}</span>
                  <span class="faq-icon mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line-strong text-ember-700" aria-hidden="true">
                    <Icon name="plus" class="h-3.5 w-3.5" />
                  </span>
                </summary>
                <p class="t-body max-w-2xl pb-6 pr-10 text-small text-ink-600">{item.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
